{
  "name": "thesis-ledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm db:generate && pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm build && node scripts/check-boundaries.mjs && eslint . --max-warnings=0",
    "security:secrets": "node scripts/check-secrets.mjs",
    "accessibility:check": "node scripts/check-accessibility.mjs",
    "release:artifacts": "node scripts/check-release-artifacts.mjs",
    "licenses:scan": "node scripts/check-licenses.mjs",
    "benchmarks:check": "node scripts/check-benchmarks.mjs",
    "benchmarks:portfolio": "pnpm --filter @thesis-ledger/server build && node scripts/portfolio-benchmark.mjs",
    "migration:matrix": "node scripts/check-migration-matrix.mjs",
    "migration:legacy-ledger": "node scripts/legacy-ledger-migration-smoke.mjs",
    "migration:thesis-ledger": "bash scripts/migrate-to-thesis-ledger.sh",
    "projection:shadow-diff": "node scripts/projection-shadow-diff.mjs",
    "projection:shadow-rebuild": "pnpm --filter @thesis-ledger/server build && node scripts/projection-shadow-rebuild.mjs",
    "projection:switch-gate": "node scripts/projection-switch-gate.mjs",
    "db:integration": "node scripts/db-integration-smoke.mjs",
    "provider:failover": "node scripts/provider-failover-smoke.mjs",
    "v1:e2e": "node scripts/v1-core-e2e-smoke.mjs",
    "contract:test": "pnpm db:generate && pnpm --filter @thesis-ledger/shared build && pnpm --filter @thesis-ledger/domain build && pnpm --filter @thesis-ledger/schemas build && pnpm --filter @thesis-ledger/api-client build && pnpm --filter @thesis-ledger/dsa-adapter build && pnpm --filter @thesis-ledger/schemas test && pnpm --filter @thesis-ledger/dsa-adapter test && pnpm --filter @thesis-ledger/api-client test && pnpm --filter @thesis-ledger/server exec vitest run test/http-validation.test.ts test/ai-trust-boundary.test.ts test/ai/research-result-persistence.test.ts test/risk-market-contracts.test.ts",
    "contract:smoke": "node scripts/thesis-ledger-contract-smoke.mjs",
    "guardrails:complexity": "eslint apps packages services --rule 'no-nested-ternary:warn' --rule 'complexity:[warn,20]' --rule 'max-lines-per-function:[warn,{max:220,skipBlankLines:true,skipComments:true}]' && node scripts/check-file-size-guardrails.mjs",
    "disaster:recovery": "node scripts/disaster-recovery-smoke.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "pnpm --filter @thesis-ledger/server prisma generate",
    "db:migrate": "pnpm --filter @thesis-ledger/server prisma migrate deploy",
    "db:seed": "pnpm --filter @thesis-ledger/server prisma db seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
