+/// A weak reference that can cross the `JavaScriptActor` scheduling boundary.
+///
+/// Event emitters are module instances and therefore are not generally
+/// `Sendable`. The scheduled closure only needs their identity and the
+/// actor-isolated `withEventTarget` method, so the weak box is the smallest
+/// boundary that keeps the lifetime semantics while making that intent
+/// explicit to Swift 6's concurrency checker.
+private final class WeakEventEmitterReference<T: AnyObject>: @unchecked Sendable {
+  weak var value: T?
+
+  init(_ value: T) {
+    self.value = value
+  }
+}
