{
  "name": "@thesis-ledger/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/backtest/backtest-worker.main.js",
    "health:worker": "node dist/src/backtest/backtest-worker-health.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma": "prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@prisma/client": "^6.13.0",
    "@thesis-ledger/domain": "workspace:*",
    "@thesis-ledger/schemas": "workspace:*",
    "@thesis-ledger/shared": "workspace:*",
    "apache-arrow": "21.2.0",
    "bullmq": "6.3.4",
    "croner": "10.0.1",
    "es-toolkit": "^1.51.0",
    "ioredis": "^5.6.1",
    "parquet-wasm": "0.7.2",
    "pinyin-pro": "3.29.2",
    "prisma": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
