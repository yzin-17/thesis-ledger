generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String                       @id @default(uuid()) @db.Uuid
  name               String
  institution        String?
  type               String
  mode               String                       @default("actual")
  currency           String                       @default("CNY")
  active             Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  positions          Position[]
  ledger             LedgerEvent[]
  snapshots          PortfolioSnapshot[]
  importDrafts       ImportDraft[]
  riskRules          RiskRule[]
  riskPositionStates RiskPositionState[]
  tradePlans         TradePlan[]
  ledgerState        AccountLedgerState?
  costStrategies     AccountCostStrategyVersion[]
  baselineBatches    BaselineObservationBatch[]
  trades             Trade[]
  cashBalances       CashBalance[]
  cashSettlements    CashSettlement[]

  @@index([active])
}

model AccountLedgerState {
  accountId            String   @id @db.Uuid
  ledgerRevision       BigInt   @default(0)
  projectionGeneration BigInt   @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model AccountCostStrategyVersion {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  revision    Int
  method      String
  effectiveAt DateTime
  reason      String
  actorId     String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  trades      Trade[]

  @@unique([accountId, revision])
  @@index([accountId, effectiveAt])
}

model Asset {
  symbol                      String                       @id
  name                        String
  market                      String
  assetType                   String
  currency                    String
  sector                      String?
  identityStatus              String                       @default("provider")
  identitySource              String?
  metadata                    Json?
  updatedAt                   DateTime                     @updatedAt
  positions                   Position[]
  trades                      Trade[]
  ledgerEvents                LedgerEvent[]
  bars                        MarketBar[]
  fundNavPoints               FundNavPoint[]
  instrumentAssetAssociations InstrumentAssetAssociation[]
}

model FundNavPoint {
  symbol       String
  navDate      DateTime
  unitNav      Decimal  @db.Decimal(24, 8)
  provider     String
  fetchedAt    DateTime
  freshness    String
  fallbackUsed Boolean  @default(false)
  asset        Asset    @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@id([symbol, navDate])
  @@index([navDate])
}

model Instrument {
  id             String                       @id @default(uuid()) @db.Uuid
  instrumentType String
  market         String
  canonicalCode  String
  displayName    String
  pinyin         String                       @default("")
  pinyinInitials String                       @default("")
  searchAliases  Json?
  generation     Int
  active         Boolean                      @default(true)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  associations   InstrumentAssetAssociation[]

  @@unique([canonicalCode, instrumentType, market])
  @@index([canonicalCode])
  @@index([displayName])
  @@index([generation, active])
}

model InstrumentAssetAssociation {
  id           String     @id @default(uuid()) @db.Uuid
  instrumentId String     @db.Uuid
  symbol       String
  status       String     @default("active")
  source       String
  confirmedAt  DateTime?
  firstSeenAt  DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  asset        Asset      @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@unique([symbol])
  @@unique([instrumentId, symbol])
  @@index([instrumentId, status])
}

model CatalogSyncState {
  consumer   String   @id
  generation Int
  checksum   String
  cursor     String
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Position {
  id                    String                 @id @default(uuid()) @db.Uuid
  accountId             String                 @db.Uuid
  symbol                String
  quantity              Decimal                @db.Decimal(38, 18)
  costPrice             Decimal                @db.Decimal(38, 18)
  source                String
  updatedAt             DateTime               @updatedAt
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset                 Asset                  @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  riskPositionStates    RiskPositionState[]
  riskRuleTriggerStates RiskRuleTriggerState[]

  @@unique([accountId, symbol])
  @@index([symbol])
}

model Trade {
  id                     String                           @id
  accountId              String                           @db.Uuid
  accountMode            String
  symbol                 String
  lifecycle              String
  exitProgress           String
  endEvidence            String
  openedAt               DateTime?
  closedAt               DateTime?
  earliestEvidenceAt     DateTime?
  sourceQuantity         Decimal                          @db.Decimal(38, 18)
  closedQuantity         Decimal                          @db.Decimal(38, 18)
  remainingQuantity      Decimal                          @db.Decimal(38, 18)
  grossRealizedPnl       Decimal?                         @db.Decimal(38, 18)
  netRealizedPnl         Decimal?                         @db.Decimal(38, 18)
  realizedNetReturnRate  Decimal?                         @db.Decimal(38, 18)
  costEstimated          Boolean                          @default(false)
  completeness           String
  issues                 Json
  costIssues             Json
  algorithmVersion       String
  projectionFingerprint  String?
  projectionGeneration   BigInt                           @default(0)
  costStrategyRevisionId String?                          @db.Uuid
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  account                Account                          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset                  Asset                            @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  costStrategyRevision   AccountCostStrategyVersion?      @relation(fields: [costStrategyRevisionId], references: [id], onDelete: Restrict)
  entryLegs              TradeEntryLeg[]
  baselineComponents     TradeBaselineComponent[]
  corporateActions       TradeCorporateActionAdjustment[]
  closeSlices            TradeCloseSlice[]
  dividendAttributions   TradeDividendAttribution[]
  evidenceSources        TradeEvidenceSource[]

  @@index([accountId, accountMode, symbol])
  @@index([accountId, projectionGeneration])
  @@index([accountId, openedAt])
  @@index([costStrategyRevisionId])
}

model TradeEntryLeg {
  id                String    @id @default(uuid()) @db.Uuid
  tradeId           String
  eventId           String
  factId            String
  occurredAt        DateTime?
  currency          String
  price             Decimal   @db.Decimal(38, 18)
  originalQuantity  Decimal   @db.Decimal(38, 18)
  quantity          Decimal   @db.Decimal(38, 18)
  remainingQuantity Decimal   @db.Decimal(38, 18)
  rawCost           Decimal?  @db.Decimal(38, 18)
  remainingCost     Decimal?  @db.Decimal(38, 18)
  rawCostEstimated  Boolean   @default(false)
  charges           Json
  trade             Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, factId])
  @@index([tradeId, occurredAt])
}

model TradeBaselineComponent {
  id                         String    @id @default(uuid()) @db.Uuid
  tradeId                    String
  eventId                    String
  factId                     String
  batchId                    String
  batchScope                 String
  occurredAt                 DateTime?
  currency                   String
  observedQuantity           Decimal   @db.Decimal(38, 18)
  quantity                   Decimal   @db.Decimal(38, 18)
  remainingQuantity          Decimal   @db.Decimal(38, 18)
  averageCost                Decimal?  @db.Decimal(38, 18)
  rawCost                    Decimal?  @db.Decimal(38, 18)
  remainingCost              Decimal?  @db.Decimal(38, 18)
  rawCostEstimated           Boolean   @default(false)
  costIncludesFees           String
  reconciledExecutionFactIds Json
  reconciliationFactIds      Json
  trade                      Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, factId])
  @@index([tradeId, occurredAt])
}

model TradeCorporateActionAdjustment {
  id                     String    @id @default(uuid()) @db.Uuid
  tradeId                String
  eventId                String
  factId                 String
  type                   String
  occurredAt             DateTime?
  quantity               Decimal?  @db.Decimal(38, 18)
  fromUnits              Decimal?  @db.Decimal(38, 18)
  toUnits                Decimal?  @db.Decimal(38, 18)
  positionQuantityBefore Decimal   @db.Decimal(38, 18)
  positionQuantityAfter  Decimal   @db.Decimal(38, 18)
  trade                  Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, factId])
  @@index([tradeId, occurredAt])
}

model TradeCloseSlice {
  id                     String                 @id
  tradeId                String
  eventId                String
  factId                 String
  occurredAt             DateTime?
  currency               String
  price                  Decimal?               @db.Decimal(38, 18)
  quantity               Decimal                @db.Decimal(38, 18)
  remainingQuantityAfter Decimal                @db.Decimal(38, 18)
  charges                Json
  grossRealizedPnl       Decimal?               @db.Decimal(38, 18)
  netRealizedPnl         Decimal?               @db.Decimal(38, 18)
  realizedNetReturnRate  Decimal?               @db.Decimal(38, 18)
  costEstimated          Boolean                @default(false)
  trade                  Trade                  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  allocations            TradeCloseAllocation[]

  @@unique([tradeId, factId])
  @@index([tradeId, occurredAt])
}

model TradeCloseAllocation {
  id                  String          @id @default(uuid()) @db.Uuid
  closeSliceId        String
  source              String
  sourceEventId       String
  sourceFactId        String
  quantity            Decimal         @db.Decimal(38, 18)
  originalCost        Decimal?        @db.Decimal(38, 18)
  allocatedBuyCharges Json
  closeSlice          TradeCloseSlice @relation(fields: [closeSliceId], references: [id], onDelete: Cascade)

  @@unique([closeSliceId, sourceFactId])
  @@index([sourceFactId])
}

model TradeDividendAttribution {
  id         String    @id @default(uuid()) @db.Uuid
  tradeId    String
  eventId    String
  factId     String
  occurredAt DateTime?
  amount     Decimal   @db.Decimal(38, 18)
  currency   String
  trade      Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, factId])
  @@index([tradeId, occurredAt])
}

model TradeEvidenceSource {
  id      String @id @default(uuid()) @db.Uuid
  tradeId String
  kind    String
  eventId String
  factId  String
  source  Json
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, kind, factId])
  @@index([tradeId, eventId])
}

model CashBalance {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @db.Uuid
  currency             String
  settledAmount        Decimal  @db.Decimal(38, 18)
  pendingReceivable    Decimal  @db.Decimal(38, 18)
  pendingPayable       Decimal  @db.Decimal(38, 18)
  completeness         String
  issues               Json
  projectionGeneration BigInt   @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, currency])
  @@index([accountId, projectionGeneration])
}

model CashSettlement {
  id                   String    @id @default(uuid()) @db.Uuid
  accountId            String    @db.Uuid
  eventId              String
  factId               String
  currency             String
  direction            String
  amount               Decimal   @db.Decimal(38, 18)
  occurredAt           DateTime?
  settledAt            DateTime?
  status               String
  sourceType           String
  projectionGeneration BigInt    @default(0)
  createdAt            DateTime  @default(now())
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, factId])
  @@index([accountId, status, settledAt])
  @@index([accountId, currency])
}

model ImportDraft {
  id                 String                @id @default(uuid()) @db.Uuid
  accountId          String                @db.Uuid
  source             String
  sourceConfidence   Decimal               @default(0) @db.Decimal(5, 4)
  scope              String                @default("FULL")
  status             String
  idempotencyKey     String                @unique
  contentFingerprint String?
  imageHash          String
  rows               Json
  baselineHash       String?
  beforeState        Json?
  createdAt          DateTime              @default(now())
  committedAt        DateTime?
  rolledBackAt       DateTime?
  currentRevision    Int                   @default(0)
  account            Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  revisions          ImportDraftRevision[]

  @@index([accountId, status])
}

model ImportDraftRevision {
  id              String      @id @default(uuid()) @db.Uuid
  draftId         String      @db.Uuid
  revision        Int
  parserVersion   String
  rawEvidenceRef  String
  contentHash     String
  scope           String      @default("FULL")
  observedAt      DateTime?
  capturedAt      DateTime?
  timePrecision   String?
  sourceTimezone  String?
  rows            Json
  issues          Json
  createdAt       DateTime    @default(now())
  submittedAt     DateTime?
  submittedRowIds Json?
  draft           ImportDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)

  @@unique([draftId, revision])
  @@index([draftId, submittedAt])
}

model BaselineObservationBatch {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @db.Uuid
  scope          String
  observedAt     DateTime?
  timePrecision  String    @default("INSTANT")
  capturedAt     DateTime?
  recordedAt     DateTime  @default(now())
  sourceCategory String
  sourceChannel  String
  externalId     String
  evidenceRef    String
  contentHash    String
  status         String    @default("DRAFT")
  submittedAt    DateTime?
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, sourceChannel, externalId])
  @@index([accountId, observedAt])
}

model LedgerEvent {
  id                   String         @id @default(uuid()) @db.Uuid
  accountId            String         @db.Uuid
  type                 String
  occurredAt           DateTime?
  symbol               String?
  quantity             Decimal?       @db.Decimal(24, 8)
  price                Decimal?       @db.Decimal(24, 8)
  amount               Decimal?       @db.Decimal(24, 8)
  fee                  Decimal?       @db.Decimal(24, 8)
  tax                  Decimal?       @db.Decimal(24, 8)
  externalId           String?
  source               String         @default("manual")
  sourceRowId          String?
  currency             String         @default("CNY")
  note                 String?
  metadata             Json?
  createdAt            DateTime       @default(now())
  factId               String?        @db.Uuid
  ledgerRevision       BigInt?
  timePrecision        String?
  sourceTimezone       String?
  economicOrderKey     String?
  recordedAt           DateTime       @default(now())
  projectionGeneration BigInt?
  payloadVersion       Int?
  payload              Json?
  sourceCategory       String?
  sourceChannel        String?
  actorId              String?
  revisionAction       String?
  supersedesEventId    String?        @db.Uuid
  reason               String?
  account              Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset                Asset?         @relation(fields: [symbol], references: [symbol], onDelete: Restrict)
  journalEntries       JournalEntry[]
  supersedesEvent      LedgerEvent?   @relation("LedgerRevisionChain", fields: [supersedesEventId], references: [id], onDelete: Restrict)
  laterRevisions       LedgerEvent[]  @relation("LedgerRevisionChain")

  @@unique([accountId, sourceChannel, externalId])
  @@unique([supersedesEventId])
  @@index([accountId, sourceChannel, sourceRowId])
  @@index([accountId, ledgerRevision])
  @@index([accountId, occurredAt])
  @@index([accountId, factId, ledgerRevision])
  @@index([accountId, occurredAt, economicOrderKey, id])
  @@index([symbol, occurredAt])
}

model PortfolioSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String?  @db.Uuid
  capturedAt  DateTime
  marketValue Decimal  @db.Decimal(24, 8)
  costValue   Decimal  @db.Decimal(24, 8)
  cashValue   Decimal  @db.Decimal(24, 8)
  payload     Json
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, capturedAt])
  @@index([capturedAt])
}

model TargetAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String
  accountId String?  @db.Uuid
  version   Int      @default(1)
  targets   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([scope, accountId, active])
}

model MarketBar {
  id           BigInt   @id @default(autoincrement())
  symbol       String
  timeframe    String
  timestamp    DateTime
  open         Decimal  @db.Decimal(24, 8)
  high         Decimal  @db.Decimal(24, 8)
  low          Decimal  @db.Decimal(24, 8)
  close        Decimal  @db.Decimal(24, 8)
  volume       Decimal  @db.Decimal(30, 8)
  amount       Decimal  @db.Decimal(30, 8)
  provider     String
  fetchedAt    DateTime @default(now())
  freshness    String   @default("unknown")
  fallbackUsed Boolean  @default(false)
  asset        Asset    @relation(fields: [symbol], references: [symbol], onDelete: Restrict)

  @@unique([symbol, timeframe, timestamp, provider])
  @@index([symbol, timeframe, timestamp])
}

model DataQualityIssue {
  id         String    @id @default(uuid()) @db.Uuid
  capability String
  symbol     String?
  provider   String
  severity   String
  code       String
  details    Json
  status     String    @default("open")
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, detectedAt])
}

model BackfillJob {
  id        String    @id @default(uuid()) @db.Uuid
  symbol    String
  timeframe String
  start     DateTime
  end       DateTime
  cursor    DateTime?
  status    String    @default("queued")
  progress  Int       @default(0)
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([symbol, timeframe, status])
}

model ProviderHealth {
  id                  String   @id @default(uuid()) @db.Uuid
  provider            String   @unique
  state               String
  consecutiveFailures Int      @default(0)
  latencyMs           Int?
  errorCode           String?
  checkedAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([state, checkedAt])
}

model ProviderHealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  state     String
  latencyMs Int?
  errorCode String?
  source    String   @default("manual")
  checkedAt DateTime

  @@index([provider, checkedAt])
  @@index([state, checkedAt])
}

model DesiredProviderPolicy {
  consumer            String                          @id
  revision            Int
  enabled             Boolean
  routes              Json
  syncState           String
  dsaRevision         Int?
  syncedAt            DateTime?
  lastError           Json?
  effectiveProjection Json?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  history             DesiredProviderPolicyRevision[]

  @@index([syncState, updatedAt])
}

model DesiredProviderPolicyRevision {
  id                  String                @id @default(uuid()) @db.Uuid
  consumer            String
  revision            Int
  enabled             Boolean
  routes              Json
  syncState           String
  dsaRevision         Int?
  syncedAt            DateTime?
  lastError           Json?
  effectiveProjection Json?
  createdAt           DateTime              @default(now())
  policy              DesiredProviderPolicy @relation(fields: [consumer], references: [consumer], onDelete: Restrict)

  @@unique([consumer, revision])
  @@index([consumer, createdAt])
}

model ProviderTombstone {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @unique
  displayName String
  reason      String?
  metadata    Json?
  removedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([removedAt])
}

model RiskRule {
  id            String                 @id @default(uuid()) @db.Uuid
  version       Int                    @default(1)
  kind          String
  scope         String
  severity      String
  threshold     Decimal                @db.Decimal(24, 8)
  enabled       Boolean                @default(true)
  needsRepair   Boolean                @default(false)
  repairReason  String?
  symbol        String?
  accountId     String?                @db.Uuid
  sourcePlanId  String?                @db.Uuid
  condition     Json?
  parameters    Json?
  config        Json?
  effectiveAt   DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  events        RiskEvent[]
  triggerStates RiskRuleTriggerState[]
  account       Account?               @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

model RiskPositionState {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @db.Uuid
  symbol            String
  mode              String    @default("actual")
  holdingPeak       Decimal   @db.Decimal(24, 8)
  peakAt            DateTime
  positionUpdatedAt DateTime?
  lastPrice         Decimal   @db.Decimal(24, 8)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  positionId        String?   @db.Uuid
  position          Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  lastQuantity      Decimal   @default(0) @db.Decimal(24, 8)

  @@unique([accountId, symbol, mode])
  @@index([symbol, mode])
  @@index([positionId])
}

model RiskRuleTriggerState {
  id            String     @id @default(uuid()) @db.Uuid
  ruleId        String     @db.Uuid
  targetKey     String
  symbol        String
  mode          String     @default("actual")
  positionId    String?    @db.Uuid
  ruleVersion   Int
  breachActive  Boolean    @default(false)
  activeEventId String?    @db.Uuid
  lastScanId    String?    @db.Uuid
  triggeredAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  rule          RiskRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  position      Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)
  activeEvent   RiskEvent? @relation(fields: [activeEventId], references: [id], onDelete: SetNull)

  @@unique([ruleId, targetKey, symbol, mode])
  @@index([positionId])
  @@index([activeEventId])
}

model RiskEvent {
  id             String                 @id @default(uuid()) @db.Uuid
  ruleId         String                 @db.Uuid
  ruleVersion    Int
  triggered      Boolean
  severity       String
  message        String
  mode           String                 @default("actual")
  accountId      String?                @db.Uuid
  symbol         String?
  triggerValue   Decimal?               @db.Decimal(24, 8)
  threshold      Decimal?               @db.Decimal(24, 8)
  marketTime     DateTime?
  scanId         String?                @db.Uuid
  dedupeKey      String                 @unique
  context        Json
  evaluatedAt    DateTime               @default(now())
  rule           RiskRule               @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  deliveries     NotificationDelivery[]
  journalEntries JournalEntry[]
  triggerStates  RiskRuleTriggerState[]

  @@index([ruleId, evaluatedAt])
  @@index([triggered, severity])
  @@index([accountId, symbol, evaluatedAt])
  @@index([mode, evaluatedAt, id])
}

model RiskRuleAudit {
  id          String   @id @default(uuid()) @db.Uuid
  ruleId      String   @db.Uuid
  ruleVersion Int
  action      String
  actor       String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([ruleId, createdAt])
}

model NotificationDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  channel         String
  provider        String
  severity        String
  status          String
  attemptCount    Int       @default(0)
  dedupKey        String
  scheduledAt     DateTime
  deliveredAt     DateTime?
  lastError       String?
  errorCode       String?
  responseSummary String?
  event           RiskEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([dedupKey, channel])
  @@index([status, scheduledAt])
  @@index([eventId])
}

model Strategy {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  status        String            @default("draft")
  schemaVersion Int               @default(1)
  archived      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  versions      StrategyVersion[]
}

model StrategyVersion {
  id             String         @id @default(uuid()) @db.Uuid
  strategyId     String         @db.Uuid
  version        Int
  schemaVersion  Int            @default(1)
  schema         Json
  createdAt      DateTime       @default(now())
  strategy       Strategy       @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  jobs           BacktestJob[]
  journalEntries JournalEntry[]

  @@unique([strategyId, version])
}

model BacktestJob {
  id                String          @id @default(uuid()) @db.Uuid
  strategyVersionId String          @db.Uuid
  status            String
  progress          Int             @default(0)
  periodStart       DateTime
  periodEnd         DateTime
  dataAsOf          DateTime
  input             Json
  result            Json?
  warnings          Json?
  cancelRequestedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?
  engineVersion     String?
  resultChecksum    String?
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model JournalEntry {
  id                String           @id @default(uuid()) @db.Uuid
  entryType         String           @default("note")
  accountId         String?          @db.Uuid
  ledgerEventId     String?          @db.Uuid
  tradePlanId       String?          @db.Uuid
  riskEventId       String?          @db.Uuid
  strategyVersionId String?          @db.Uuid
  symbol            String?
  side              String?
  reason            String
  content           String?
  tags              Json?
  thesis            String?
  catalyst          String?
  risk              String?
  exitReason        String?
  emotion           String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ledgerEvent       LedgerEvent?     @relation(fields: [ledgerEventId], references: [id], onDelete: Restrict)
  riskEvent         RiskEvent?       @relation(fields: [riskEventId], references: [id], onDelete: Restrict)
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)

  @@index([symbol, createdAt])
  @@index([accountId, createdAt])
  @@index([tradePlanId, createdAt])
  @@index([ledgerEventId])
  @@index([riskEventId])
  @@index([strategyVersionId])
}

model TradePlan {
  id                  String    @id @default(uuid()) @db.Uuid
  accountId           String?   @db.Uuid
  tradeId             String?
  symbol              String
  side                String?
  plannedEntry        Decimal?  @db.Decimal(24, 8)
  plannedExit         Decimal?  @db.Decimal(24, 8)
  stopLoss            Decimal?  @db.Decimal(24, 8)
  takeProfit          Decimal?  @db.Decimal(24, 8)
  targetWeight        Decimal?  @db.Decimal(12, 8)
  expectedHoldingDays Int?
  plannedEntryAt      DateTime?
  plannedExitAt       DateTime?
  reason              String?
  thesis              String?
  status              String    @default("active")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  account             Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([symbol, status])
  @@index([accountId, status])
  @@index([tradeId, status])
}

model JournalReviewSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @db.Uuid
  mode                  String
  reviewObjectType      String
  tradeId               String
  closeSliceId          String?
  factIds               Json
  eventIds              Json
  ledgerRevision        BigInt
  projectionGeneration  BigInt
  projectionFingerprint String?
  fxEvidenceVersion     String?
  conversionFingerprint String?
  inputSnapshot         Json
  outputSnapshot        Json
  status                String   @default("CURRENT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([accountId, reviewObjectType, tradeId])
  @@index([tradeId, closeSliceId, createdAt])
  @@index([status, createdAt])
}

model ProviderConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  type                 String
  enabled              Boolean  @default(true)
  priority             Int
  capabilities         Json
  settings             Json?
  encryptedCredentials Bytes?
  quota                Json?
  cost                 Json?
  health               String   @default("unknown")
  updatedAt            DateTime @updatedAt
}

model AutomationJob {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        String
  cron        String
  timezone    String          @default("Asia/Shanghai")
  enabled     Boolean         @default(true)
  retryPolicy Json
  lockTtlMs   Int
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runs        AutomationRun[]
}

model AutomationRun {
  id         String        @id @default(uuid()) @db.Uuid
  jobId      String        @db.Uuid
  status     String
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  attempt    Int           @default(1)
  traceId    String
  output     Json?
  error      String?
  job        AutomationJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, startedAt])
  @@index([status])
}

model AiRun {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String
  model            String
  promptVersion    String
  status           String
  question         String?
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cost             Decimal   @default(0) @db.Decimal(18, 8)
  checkpoint       Json?
  result           Json?
  context          Json?
  modelMetadata    Json?
  errorCode        String?
  errorSummary     String?
  durationMs       Int?
  startedAt        DateTime?
  completedAt      DateTime?
  retryOfRunId     String?   @db.Uuid
  executionAttempt Int       @default(0)
  claimedAt        DateTime?
  leaseUntil       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  toolCalls AiToolCall[]

  @@index([status, createdAt])
  @@index([status, createdAt, id])
  @@index([retryOfRunId])
  @@index([leaseUntil])
}

model AiToolCall {
  id            String    @id @default(uuid()) @db.Uuid
  aiRunId       String    @db.Uuid
  tool          String
  permission    String
  status        String
  inputSummary  String
  outputSummary String?
  provider      String?
  durationMs    Int?
  marketTime    DateTime?
  availableAt   DateTime?
  fetchedAt     DateTime?
  createdAt     DateTime  @default(now())
  aiRun         AiRun     @relation(fields: [aiRunId], references: [id], onDelete: Restrict)

  @@index([aiRunId, createdAt])
  @@index([tool, status, createdAt])
}

model AiDecisionLog {
  id          String   @id @default(uuid()) @db.Uuid
  symbol      String?
  accountId   String?  @db.Uuid
  question    String
  assumptions Json
  conclusion  Json
  context     Json?
  provenance  Json?
  createdAt   DateTime @default(now())

  @@index([symbol, createdAt])
  @@index([accountId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  resource   String
  resourceId String?
  traceId    String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId, createdAt])
}
