    "@investment-os/domain": "workspace:*",
    "expo": "57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.5"
  }
}
