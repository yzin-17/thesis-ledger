{
  "name": "@thesis-ledger/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.101.4",
    "@thesis-ledger/api-client": "workspace:*",
    "@thesis-ledger/domain": "workspace:*",
    "@thesis-ledger/schemas": "workspace:*",
    "es-toolkit": "1.51.0",
    "expo": "57.0.9",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-sharing": "~57.0.23",
    "lightweight-charts": "5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-modules-core"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.5"
  }
}
