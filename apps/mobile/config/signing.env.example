# 通过现有安全入口设置环境变量；此文件不应填写真实值后提交。
# Android 接续脚本采用完整环境变量；优先于 keystore.properties。
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# iOS 描述文件须已由受控环境安装，脚本只读取，不导入或联网登记。
IOS_PROVISIONING_PROFILE=
# 目标设备可访问的 HTTPS API 在本地 release.local.json 配置。
# Team、证书指纹和签名身份 SHA-1 是公开元数据，也在 release.local.json 配置。
